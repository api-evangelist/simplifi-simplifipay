{
  "opencollection": "1.0.0",
  "info": {
    "name": "SimpliFi Cards Auth Fee API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Fee",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add fee configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v2/fees",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Configure fee based on transaction types and apply them to a card program template.\nFollowing are the properties of this endpoint."
        },
        {
          "info": {
            "name": "Fetch fee config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{env}-lb.simplifipay.com/v2/fees/:uuid",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "This is the unique identifier of the fee configuration."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint fetches the fee config"
        },
        {
          "info": {
            "name": "Change the status of fee config",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{env}-lb.simplifipay.com/v1/fees/:uuid",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "This is the unique identifier of the fee configuration."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint changes the status of the fee config"
        },
        {
          "info": {
            "name": "Add Fee event against card uuid in queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v1/fees/application/card/:cardUuid",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cardUuid",
                "value": "",
                "type": "path",
                "description": "This is the unique identifier of the card."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add Fee event against card uuid in queue"
        },
        {
          "info": {
            "name": "Apply fee against card uuid present in queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v1/fees/application/card/:cardUuid/apply",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cardUuid",
                "value": "",
                "type": "path",
                "description": "This is the unique identifier of the card."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Apply fee against card uuid present in queue"
        }
      ]
    }
  ],
  "bundled": true
}