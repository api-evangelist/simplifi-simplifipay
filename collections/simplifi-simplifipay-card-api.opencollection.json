{
  "opencollection": "1.0.0",
  "info": {
    "name": "SimpliFi Cards Auth Card API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Card",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Cards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{env}-lb.simplifipay.com/v1/card",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cardStatus",
                "value": "",
                "type": "query",
                "description": "This field contains comma separated list of card status to filter the request upon.\nList of Active Cards are 'ACTIVATED,ISSUED,PENDING,LOCKED' and a list of Inactive\nCards are 'REJECTED,DISABLED,REPLACED,EXPIRED'"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "This field contains the page number currently being displayed for cards."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "This field contains the number of the card records to be displayed on this page."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The List all Cards endpoint retrieves all the existing cards, grouped under a company.\nFollowing are the properties of this endpoint."
        },
        {
          "info": {
            "name": "Create a Card",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v1/card",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The Create a Card endpoint creates/issues a card to a user under a Card Program. The card issued\nusing this endpoint would inherit the characteristics defined in its card program such as\nauthorization controls, velocity controls etc. Following are the properties of this endpoint."
        },
