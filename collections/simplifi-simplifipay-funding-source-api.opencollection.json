          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v1/funding-source/:thirdPartyId/rule-group",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "thirdPartyId",
                "value": "",
                "type": "path",
                "description": "This is a unique identifier for the Account ID of funding source (wallet)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The 'Create Rule Group' endpoint creates new rule group on the Funding Account."
        },
        {
          "info": {
            "name": "Update Rule Group on Funding Account",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{env}-lb.simplifipay.com/v1/funding-source/:thirdPartyId/rule-group",
            "headers": [
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "thirdPartyId",
                "value": "",
                "type": "path",
                "description": "This is a unique identifier for the Account ID of funding source (wallet)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The 'Update Rule Group' endpoint updates an existing group on the Funding Account."
        },
        {
          "info": {
            "name": "Delete Rule Group on Funding Account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{env}-lb.simplifipay.com/v1/funding-source/:thirdPartyId/rule-group",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "thirdPartyId",
                "value": "",
                "type": "path",
                "description": "This is a unique identifier for the Account ID of funding source (wallet)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The 'Delete Rule Group' endpoint deletes an existing group on the Funding Account."
        },
        {
          "info": {
            "name": "Appply Rule Group on Funding Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v1/funding-source/:thirdPartyId/rule-group/:ruleGroupUuid",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "thirdPartyId",
                "value": "",
                "type": "path",
                "description": "This is a unique identifier for the Account ID of funding source (wallet)"
              },
              {
                "name": "ruleGroupUuid",
                "value": "",
                "type": "path",
                "description": "This is a unique identifier for the Rule Group"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The 'Apply Rule Group' endpoint applies an existing rule group on the Funding Account."
        },
        {
          "info": {
            "name": "Remove Rule Group on Funding Account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{env}-lb.simplifipay.com/v1/funding-source/:thirdPartyId/rule-group/:ruleGroupUuid",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "thirdPartyId",
                "value": "",
                "type": "path",
                "description": "This is a unique identifier for the Account ID of funding source (wallet)"
              },
              {
                "name": "ruleGroupUuid",
                "value": "",
