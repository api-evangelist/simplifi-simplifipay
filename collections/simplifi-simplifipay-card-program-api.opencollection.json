{
  "opencollection": "1.0.0",
  "info": {
    "name": "SimpliFi Cards Auth Card Program API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Card Program",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Card Program",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v1/card-program",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The Create Card Program endpoint allows API users to create a new card program\nto be associated with cards of the SimpliFi platform."
        },
        {
          "info": {
            "name": "Get Card Program",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{env}-lb.simplifipay.com/v1/card-program/:uuid",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "This is a unique identifier for the program that was created using the Create Card Program API."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The Get Card Program endpoint retrieves details about a card program.\nFollowing are the properties of this endpoint."
        },
        {
          "info": {
            "name": "Change Card Program Status",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{env}-lb.simplifipay.com/v1/card-program/:uuid/status",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "This is a unique identifier for the program that was created using the Create Card Program API."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The Change Card Program Status endpoint changes the status of a card program. This endpoint is helpful\nwhen a card program is to be suspended or activated as per the business needs. Following are the\nproperties of this endpoint."
        },
        {
          "info": {
            "name": "Link Funding Source to Card Program",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v2/card-program/:uuid/funding-source",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "This is a unique identifier for the program that was created using the Create Card Program API."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The Link Funding Source to Card Program endpoint links a funding source to a card program.\nThe funding source works as an account that would be used to fund all its cards under this\nCard Program. Following are the properties of this endpoint."
        },
        {
          "info": {
            "name": "Get Balance of Funding Source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{env}-lb.simplifipay.com/v1/card-program/:uuid/funding-source-balance",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "This is a unique identifier for the program that was created using the Create Card Program API."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The Get Balance of Funding Source endpoint retrieves the remaining balance of a funding source.\nFollowing are the properties of this endpoint."
        },
        {
          "info": {
            "name": "Transfer funds from one Card Program to other",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v1/card-program/transfer-fund",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The Transfer Fund endpoint allows API users to transfer funds from a one\nCard Program to other Card Program. Following are the properties of this endpoint."
        },
        {
          "info": {
            "name": "Raise Funding Document Upload",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v1/document/upload",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "cardProgramUuid",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "amount",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "fundRequestType",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This API should be called before calling Raise Funding API to attach `Proof of funds / Confirmation of\nfunds transfer from the Bank` document (PNG, JPEG, PDF are allowed formats) and the string value returned\nin the `documentUploadUuid` field of the response should be used in Raise Funding API's document parameter.\n\nNote: After the funds are transferred from the whitelisted Bank account to the Issuer/Processor Bank\naccount, the confirmation of transfer of funds screenshot/image/PDF should be use"
        },
        {
          "info": {
            "name": "Raise Funding",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{env}-lb.simplifipay.com/v1/card-program/raise-funding",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The Raise Funding endpoint helps in adding or removing funds from a funding source. This API doesn't\nactually move the money between accounts but should be used so that the proof of funds is shared with\nthe Issuer/Processor Bank. After the proof of funds attachment is verified by the Issuer/Processor\nfunds would reflect in the respective funding source. Following are the properties of this endpoint."
        },
        {
          "info": {
            "name": "Funding Source Statement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{env}-lb.simplifipay.com/v1/statement",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "requestUuid",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "query",
                "description": "The account ID of the processor mapping (wallet)."
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "start date of date-range"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "end date date of date-range"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "sort statement column value"
              },
              {
                "name": "sortDir",
                "value": "",
                "type": "query",
                "description": "sort direction"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get funding source statement based on date range."
        }
      ]
    }
  ],
  "bundled": true
}