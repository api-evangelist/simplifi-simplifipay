        {
          "id": "6786e65a-e4f1-41ba-a11e-4bb06429bccf",
          "name": "Raise Funding Document Upload",
          "request": {
            "name": "Raise Funding Document Upload",
            "description": {
              "content": "This API should be called before calling Raise Funding API to attach `Proof of funds / Confirmation of\nfunds transfer from the Bank` document (PNG, JPEG, PDF are allowed formats) and the string value returned\nin the `documentUploadUuid` field of the response should be used in Raise Funding API's document parameter.\n\nNote: After the funds are transferred from the whitelisted Bank account to the Issuer/Processor Bank\naccount, the confirmation of transfer of funds screenshot/image/PDF should be used as an attachment.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "document",
                "upload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Environment token issued by SimpliFi",
                  "type": "any",
                  "value": "{{env}}",
                  "key": "env"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) A unique id is required to be passed as part of the header whenever a SimpliFi API is called from your\nsystem. This would help us in debugging in case of a discrepancy in the expected behavior of the API.",
                "key": "requestUuid",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) "
                },
                {
                  "key": "cardProgramUuid",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) This field contains the system generated unique identifier for the program\nthat was created using the Create Card Program API."
                },
                {
                  "key": "amount",
                  "value": "<number>",
                  "type": "text",
                  "description": "(Required) This field contains the amount that has been requested for fund transfer."
                },
                {
                  "key": "fundRequestType",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) This field contains the type for fund request. (This can only be one of LOAD,UNLOAD)"
                }
              ]
            }
          },
          "response": [
